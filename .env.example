# Copiar a .env y completar con valores reales. NUNCA commitear .env con secretos reales.

# --- Postgres ---
POSTGRES_DB=korzadi_wallet
POSTGRES_USER=korzadi
POSTGRES_PASSWORD=change_me_strong_password

# --- Backend ---
DATABASE_URL=postgres://korzadi:change_me_strong_password@localhost:5432/korzadi_wallet?sslmode=disable
JWT_SECRET=change_me_min_32_chars_random_secret
PORT=8060

# --- Frontend ---
VITE_API_URL=http://localhost:8060

# --- Providers externos (fase 2, sin valores reales todavía) ---
PAYMENT_PROVIDER_API_KEY=
PAYMENT_PROVIDER_WEBHOOK_SECRET=
KYC_PROVIDER_API_KEY=
CRYPTO_CUSTODY_API_KEY=

# --- Integración KorzadiVPN (fase 12) ---
KORZADIVPN_API_BASE_URL=
KORZADIVPN_API_KEY=
KORZADIVPN_HMAC_SECRET=

# ==============================
# BSC / BEP-20
# ==============================
# BSC mainnet: chain ID 56
# Configure the production RPC URL explicitly.
BSC_RPC_URL=
BSC_CHAIN_ID=56
USDT_BSC_CONTRACT=
USDT_DECIMALS=18
BSC_CONFIRMATIONS_REQUIRED=15
BSC_RPC_TIMEOUT=10s
BSC_RPC_MAX_RETRIES=3
BSC_RPC_BACKOFF_BASE=250ms
BSC_RPC_BACKOFF_MAX=5s

# ==============================
# Ethereum / ERC-20
# ==============================
# ETH mainnet: chain ID 1. Finality is enforced with >=64 confirmations.
ETH_RPC_URL=
ETH_CHAIN_ID=1
ETH_CONFIRMATIONS_REQUIRED=64

# ==============================
# Fee price oracle
# ==============================
# Optional CoinGecko demo API key; never put a real key in this example file.
FEE_PRICE_API_KEY=
# Binance is the secondary provider used when CoinGecko has no valid quote.
FEE_PRICE_SECONDARY_BASE_URL=https://api.binance.com/api/v3
FEE_MAX_PRICE_AGE=5m
FEE_PRICE_CACHE_TTL=30s

# ---- Correo transaccional (Fase C: verificación de email y restablecimiento) ----
# URL pública del frontend, sin barra final: se usa para construir los enlaces de los correos.
APP_BASE_URL=https://wallet.korzadi.com
# Servidor SMTP. Puerto 465 = TLS implícito; otros puertos exigen STARTTLS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM="Korzadi Wallet <no-reply@korzadi.com>"
SMTP_REQUIRE_TLS=true
# SOLO desarrollo: sin SMTP, imprime en logs el cuerpo (con enlaces de un solo uso) de los correos.
EMAIL_DEV_LOG_LINKS=false

# ---- Retiros: espera de seguridad para direcciones nuevas (Fase D) ----
# Tiempo que debe pasar desde que se pide un retiro a una dirección nueva hasta poder usarla (0 = desactivado).
WITHDRAWAL_NEW_DESTINATION_COOLDOWN=24h

# --- Claves de custodia (ver backend/docs/CUSTODY_KEY_MANAGEMENT.md) ---
# Multi-clave: "id=hex64,id2=hex64". CUSTODY_ACTIVE_KEY_ID cifra; las demás solo descifran.
# Genera cada clave con: openssl rand -hex 32   (NUNCA reutilices ni compartas valores reales)
# CUSTODY_ENCRYPTION_KEYS=k1=<hex64>,k2=<hex64>
# CUSTODY_ACTIVE_KEY_ID=k2
# Variable histórica (una sola clave, id "default"); se usa solo si CUSTODY_ENCRYPTION_KEYS está vacío:
# CUSTODY_ENCRYPTION_KEY=<hex64>
